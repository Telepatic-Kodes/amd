# ============================================================
# AI Marketing Department — Environment Variables
# ============================================================
# Copy to .env.local for local development:
#   cp .env.example .env.local
#
# Scopes: DEV = local, STAGING = Vercel preview, PROD = Vercel production
# ============================================================

# === CONVEX (Backend) ===
# Dev: auto-set by `npx convex dev`
# Staging: auto-set by Convex-Vercel integration (preview deployments)
# Prod: set in Vercel Dashboard -> Environment Variables (Production scope)
CONVEX_DEPLOYMENT=your-deployment-name
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Convex deploy key (CI/CD only — NOT for local dev)
# Generate at: Convex Dashboard -> Project -> Settings -> Deploy Key
# Set in: GitHub Secrets as CONVEX_DEPLOY_KEY
CONVEX_DEPLOY_KEY=

# === CLERK (Authentication) ===
# Dev: pk_test_xxx / sk_test_xxx (from Clerk development instance)
# Staging: same as dev (preview uses development instance)
# Prod: pk_live_xxx / sk_live_xxx (from Clerk production instance)
# Get keys at: Clerk Dashboard -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
CLERK_SECRET_KEY=sk_test_xxxxx

# Dev auth bypass (set to "true" to skip Clerk login in local dev)
# NEVER set to "true" in production
NEXT_PUBLIC_DEV_AUTH_BYPASS=false

# === ANTHROPIC (AI / LLM) ===
# Same key across all environments (set in both .env.local AND Convex Dashboard)
# Get at: console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=sk-ant-api03-xxxxx

# === OAUTH — Social Platform Credentials ===
# These are set as Convex environment variables in the Convex Dashboard,
# NOT in .env.local. Each platform needs dev + prod callback URLs.
#
# LinkedIn (Developer Portal: linkedin.com/developers)
# Dev callback:  http://localhost:3000/api/linkedin/callback
# Prod callback: https://YOUR_DOMAIN/api/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
#
# Twitter/X (Developer Portal: developer.twitter.com)
# Dev callback:  http://localhost:3000/api/twitter/callback
# Prod callback: https://YOUR_DOMAIN/api/twitter/callback
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
#
# Instagram/Meta (Developer Portal: developers.facebook.com)
# Dev callback:  http://localhost:3000/api/instagram/callback
# Prod callback: https://YOUR_DOMAIN/api/instagram/callback
# Note: Instagram requires Meta App Review (1-2 weeks)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# === FRONTEND URL (Convex environment variable) ===
# Used by Convex actions to build OAuth callback URLs
# Dev: http://localhost:3000
# Staging: Vercel preview URL (set dynamically or use a fixed staging URL)
# Prod: https://YOUR_DOMAIN
FRONTEND_URL=http://localhost:3000

# === EMAIL (Resend) ===
# Used for automated report delivery
# Get at: resend.com/api-keys
RESEND_API_KEY=

# === OPTIONAL INTEGRATIONS ===
# n8n webhook base URL (for agent orchestration workflows)
N8N_WEBHOOK_BASE_URL=
N8N_API_KEY=

# ============================================================
# WHERE TO SET EACH VARIABLE:
#
# Local dev (.env.local):
#   CONVEX_DEPLOYMENT, NEXT_PUBLIC_CONVEX_URL (auto by convex dev)
#   NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY, CLERK_SECRET_KEY
#   ANTHROPIC_API_KEY
#   NEXT_PUBLIC_DEV_AUTH_BYPASS=true (optional)
#
# Convex Dashboard (Environment Variables):
#   ANTHROPIC_API_KEY
#   LINKEDIN_CLIENT_ID, LINKEDIN_CLIENT_SECRET
#   TWITTER_CLIENT_ID, TWITTER_CLIENT_SECRET
#   INSTAGRAM_APP_ID, INSTAGRAM_APP_SECRET
#   FRONTEND_URL
#   RESEND_API_KEY
#
# Vercel Dashboard (Environment Variables):
#   NEXT_PUBLIC_CONVEX_URL (Production scope)
#   NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY (Production = pk_live_*)
#   CLERK_SECRET_KEY (Production = sk_live_*)
#   CONVEX_DEPLOY_KEY (Production scope)
#
# GitHub Secrets (CI/CD):
#   CONVEX_DEPLOY_KEY
#   VERCEL_TOKEN, VERCEL_ORG_ID, VERCEL_PROJECT_ID
# ============================================================

# Google Drive Integration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
